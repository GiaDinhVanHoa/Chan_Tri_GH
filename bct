!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bang Chan Tri 4 Phep Toan - Bitwise</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f6f9;
            color: #333;
            margin: 0;
            padding: 30px 15px;
            display: flex;
            justify-content: center;
        }
        
        .container {
            background: #ffffff;
            padding: 25px 30px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            max-width: 600px;
            width: 100%;
        }
        
        h2 {
            text-align: center;
            color: #1a73e8;
            margin-top: 0;
        }
        
        .control-group {
            margin-bottom: 20px;
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #e9ecef;
        }
        
        label {
            font-weight: 600;
            display: block;
            margin-bottom: 8px;
        }
        
        select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ced4da;
            border-radius: 6px;
            font-size: 15px;
            outline: none;
        }
        
        .bitwise-box {
            background-color: #e8f0fe;
            border-left: 4px solid #1a73e8;
            padding: 10px 15px;
            font-size: 13px;
            margin-bottom: 20px;
            border-radius: 0 6px 6px 0;
            line-height: 1.6;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
        }
        
        th,
        td {
            border: 1px solid #dee2e6;
            padding: 10px;
            text-align: center;
            font-size: 15px;
        }
        
        th {
            background-color: #1a73e8;
            color: white;
        }
        
        tr:nth-child(even) {
            background-color: #f8f9fa;
        }
        
        .bit-1 {
            color: #2e7d32;
            font-weight: bold;
        }
        
        .bit-0 {
            color: #d32f2f;
            font-weight: bold;
        }
        
        .badge {
            margin-top: 20px;
            padding: 12px;
            border-radius: 8px;
            font-weight: bold;
            text-align: center;
            font-size: 15px;
        }
        
        .tautology {
            background: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #c8e6c9;
        }
        
        .contingency {
            background: #fff8e1;
            color: #f57f17;
            border: 1px solid #ffe082;
        }
        
        .contradiction {
            background: #ffebee;
            color: #c62828;
            border: 1px solid #ffcdd2;
        }
    </style>
</head>

<body>

    <div class="container">
        <h2>Bang Chan Tri (4 Phep Toan Logic)</h2>

        <div class="control-group">
            <label for="algoSelect">Chon phep toan:</label>
            <select id="algoSelect" onchange="runBitwiseTable()">
            <option value="1">1. Hoi (AND): P ^ Q</option>
            <option value="2">2. Tuyen (OR): P v Q</option>
            <option value="3">3. Keo theo (IMPLIES): P -> Q</option>
            <option value="4">4. Tuong duong (IFF): P <-> Q</option>
        </select>
        </div>

        <div class="bitwise-box" id="bitwiseDesc"></div>

        <table id="truthTable"></table>

        <div id="resultBadge" class="badge"></div>
    </div>

    <script>
        const operations = {
            1: {
                name: "Hoi (AND): P ^ Q",
                desc: "Toan tu bit: <code>p & q</code>",
                calc: (p, q) => p & q
            },
            2: {
                name: "Tuyen (OR): P v Q",
                desc: "Toan tu bit: <code>p | q</code>",
                calc: (p, q) => p | q
            },
            3: {
                name: "Keo theo (IMPLIES): P -> Q",
                desc: "Cong thuc bit: <code>((~p & 1) | q)</code>",
                calc: (p, q) => ((~p & 1) | q)
            },
            4: {
                name: "Tuong duong (IFF): P <-> Q",
                desc: "Cong thuc bit: <code>((p ^ q) ^ 1)</code>",
                calc: (p, q) => ((p ^ q) ^ 1)
            }
        };

        function runBitwiseTable() {
            const choice = document.getElementById("algoSelect").value;
            const currentOp = operations[choice];
            const n = 2;
            const totalRows = 1 << n;

            document.getElementById("bitwiseDesc").innerHTML =
                `<strong>Bitwise:</strong> Duyet <code>mask = 0</code> den <code>${totalRows - 1}</code> (tong <code>1 &lt;&lt; 2 = 4</code> dong).<br>` +
                `Trich xuat: <code>P = (mask >> 1) & 1</code> | <code>Q = (mask >> 0) & 1</code>.<br>` +
                currentOp.desc;

            let tableHtml = `
        <thead>
            <tr>
                <th>Thap phan (mask)</th>
                <th>Nhi phan</th>
                <th>P</th>
                <th>Q</th>
                <th>Ket qua</th>
            </tr>
        </thead>
        <tbody>
    `;

            let trueCount = 0;

            for (let mask = 0; mask < totalRows; mask++) {
                let p = (mask >> 1) & 1;
                let q = (mask >> 0) & 1;

                let res = currentOp.calc(p, q);
                if (res === 1) trueCount++;

                let binStr = mask.toString(2).padStart(2, '0');

                tableHtml += `
            <tr>
                <td>${mask}</td>
                <td><code>${binStr}</code></td>
                <td class="bit-${p}">${p}</td>
                <td class="bit-${q}">${q}</td>
                <td class="bit-${res}">${res}</td>
            </tr>
        `;
            }

            tableHtml += `</tbody>`;
            document.getElementById("truthTable").innerHTML = tableHtml;

            const badge = document.getElementById("resultBadge");
            if (trueCount === totalRows) {
                badge.className = "badge tautology";
                badge.textContent = `=> KET LUAN: HANG DUNG (Tautology) - 4/4 dong = 1`;
            } else if (trueCount === 0) {
                badge.className = "badge contradiction";
                badge.textContent = `=> KET LUAN: HANG SAI (Contradiction) - 0/4 dong = 1`;
            } else {
                badge.className = "badge contingency";
                badge.textContent = `=> KET LUAN: KHA THOA (Contingency) - Co ${trueCount}/4 dong = 1`;
            }
        }

        runBitwiseTable();
    </script>

</body>

</html>
